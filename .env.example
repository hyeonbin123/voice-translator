# Database (the docker compose "db" service). The host port avoids the 5432-5631 range
# that Windows can reserve; change POSTGRES_HOST_PORT and DATABASE_URL together.
POSTGRES_USER=vtuser
POSTGRES_PASSWORD=vtpass
POSTGRES_DB=voicetranslator
POSTGRES_HOST_PORT=55442
DATABASE_URL=postgresql+asyncpg://vtuser:vtpass@localhost:55442/voicetranslator

# API settings are read from environment variables (no implicit .env loading).
# Without JWT_SECRET_KEY, a random process-local key is used: restarts log users out.
# For multiple workers or persistent sessions, generate one shared secret of at least
# 32 UTF-8 bytes (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))").
# JWT_SECRET_KEY=<generated-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional test admin connection; conftest creates/drops a unique vt_test_<uuid> DB.
# TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://vtuser:vtpass@localhost:55442/postgres
