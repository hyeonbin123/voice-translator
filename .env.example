# Database (the docker compose "db" service). The host port avoids the 5432-5631 range
# that Windows can reserve; change POSTGRES_HOST_PORT and DATABASE_URL together.
POSTGRES_USER=vtuser
POSTGRES_PASSWORD=vtpass
POSTGRES_DB=voicetranslator
POSTGRES_HOST_PORT=55442
# The database listens on this machine only (127.0.0.1). Set 0.0.0.0 only if another machine must
# reach it, and then change the example password above first.
# POSTGRES_HOST_IP=127.0.0.1
# 127.0.0.1 rather than localhost: the database listens on IPv4 only, and localhost may try IPv6 first.
DATABASE_URL=postgresql+asyncpg://vtuser:vtpass@127.0.0.1:55442/voicetranslator

# API settings are read from environment variables (no implicit .env loading).
# Without JWT_SECRET_KEY, a random process-local key is used: restarts log users out.
# For multiple workers or persistent sessions, generate one shared secret of at least
# 32 UTF-8 bytes (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))").
# JWT_SECRET_KEY=<generated-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# docker compose up --build: the screen is served on WEB_HOST_PORT and passes /api to the api service,
# which reads JWT_SECRET_KEY from this file (the compose file sets its own DATABASE_URL).
WEB_HOST_PORT=8080
# Optional test admin connection; conftest creates/drops a unique vt_test_<uuid> DB.
# TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://vtuser:vtpass@127.0.0.1:55442/postgres
# 선택: 오타 교정 모델(qwen2.5:1.5b-instruct)을 측정한 빌드로 묶는다(Ollama /api/tags의 digest,
# docs/experiments.md 16절 '실행 조건'). Ollama에 다른 빌드가 있으면 교정만 꺼지고 경고가 남는다(서버는 뜬다).
# 비우거나 두지 않으면 빌드를 확인하지 않는다.
# CORRECTION_DIGEST=65ec06548149b04c096a120e4a6da9d4017ea809c91734ea5631e89f96ddc57b
